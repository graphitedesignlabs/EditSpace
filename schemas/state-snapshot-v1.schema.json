{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://protocol.editspace.dev/schemas/state-snapshot-v1.schema.json",
  "title": "EditSpace resolved-state snapshot v1",
  "type": "object",
  "required": ["kind", "v", "doc", "entities", "tombstones", "applied"],
  "properties": {
    "kind": { "const": "editspace-state-snapshot" },
    "v": { "const": 1 },
    "doc": { "$ref": "common-v1.schema.json#/$defs/identifier" },
    "entities": {
      "type": "array",
      "items": { "$ref": "#/$defs/entity" }
    },
    "tombstones": {
      "type": "array",
      "items": { "$ref": "#/$defs/tombstone" }
    },
    "applied": {
      "type": "array",
      "items": { "$ref": "common-v1.schema.json#/$defs/identifier" },
      "uniqueItems": true
    }
  },
  "$defs": {
    "fieldRegister": {
      "type": "object",
      "required": ["value", "stamp"],
      "properties": {
        "value": {},
        "stamp": { "$ref": "common-v1.schema.json#/$defs/stamp" }
      },
      "additionalProperties": false
    },
    "entity": {
      "type": "object",
      "required": ["reference", "fieldRegisters", "arguments", "links", "createdBy", "creationStamp", "updatedBy"],
      "properties": {
        "reference": { "$ref": "common-v1.schema.json#/$defs/entityReference" },
        "sourceID": { "$ref": "common-v1.schema.json#/$defs/identifier" },
        "fieldRegisters": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/fieldRegister" }
        },
        "arguments": { "type": "object" },
        "links": {
          "type": "array",
          "items": { "$ref": "common-v1.schema.json#/$defs/entityReference" },
          "uniqueItems": true
        },
        "createdBy": { "$ref": "common-v1.schema.json#/$defs/identifier" },
        "creationStamp": { "$ref": "common-v1.schema.json#/$defs/stamp" },
        "updatedBy": { "$ref": "common-v1.schema.json#/$defs/identifier" }
      },
      "additionalProperties": false
    },
    "tombstone": {
      "type": "object",
      "required": ["reference", "deletedBy", "stamp"],
      "properties": {
        "reference": { "$ref": "common-v1.schema.json#/$defs/entityReference" },
        "deletedBy": { "$ref": "common-v1.schema.json#/$defs/identifier" },
        "stamp": { "$ref": "common-v1.schema.json#/$defs/stamp" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
