{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://protocol.editspace.dev/schemas/common-v1.schema.json",
  "title": "EditSpace v1 common definitions",
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "safeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "positiveSafeInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "stamp": {
      "type": "object",
      "required": ["seq", "actor", "op"],
      "properties": {
        "seq": { "$ref": "#/$defs/safeInteger" },
        "actor": { "$ref": "#/$defs/identifier" },
        "op": { "$ref": "#/$defs/identifier" }
      },
      "additionalProperties": false
    },
    "entityReference": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": {
        "kind": { "$ref": "#/$defs/token" },
        "id": { "$ref": "#/$defs/identifier" }
      },
      "additionalProperties": true
    },
    "producer": {
      "type": "object",
      "required": ["app", "library"],
      "properties": {
        "app": { "type": "string" },
        "appVersion": { "type": "string" },
        "library": { "type": "string" },
        "libraryVersion": { "type": "string" }
      },
      "additionalProperties": true
    },
    "operation": {
      "type": "object",
      "required": ["doc", "op", "actor", "seq", "action", "entity"],
      "properties": {
        "v": { "$ref": "#/$defs/positiveSafeInteger", "default": 1 },
        "doc": { "$ref": "#/$defs/identifier" },
        "op": { "$ref": "#/$defs/identifier" },
        "actor": { "$ref": "#/$defs/identifier" },
        "seq": { "$ref": "#/$defs/safeInteger" },
        "deps": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" },
          "uniqueItems": true,
          "default": []
        },
        "action": { "$ref": "#/$defs/token" },
        "entity": { "$ref": "#/$defs/token" },
        "target": { "$ref": "#/$defs/identifier" },
        "source": { "$ref": "#/$defs/identifier" },
        "fields": { "type": "object", "default": {} },
        "args": { "type": "object", "default": {} },
        "features": {
          "type": "array",
          "items": { "$ref": "#/$defs/token" },
          "uniqueItems": true,
          "default": []
        },
        "producer": { "$ref": "#/$defs/producer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": true
    }
  }
}
